{
  "name": "v3dariovr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps packages scripts tests *.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:server": "tsx watch apps/server/index.ts",
    "start:server": "tsx apps/server/index.ts",
    "test:load": "tsx tests/load.ts",
    "preview": "vite preview --host 0.0.0.0",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node dist-server/index.mjs",
    "format": "prettier --write apps packages scripts tests *.ts",
    "test:production": "node tests/production.mjs"
  },
  "dependencies": {
    "sirv": "3.0.2",
    "three": "0.186.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}